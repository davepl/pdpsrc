  		/*
  		 * If -t flag has not been specified, and spec contains either
  		 * a ':' or a '@' then assume that an NFS filesystem is being
! 		 * specified ala Sun.  mount_nfs (from bsd/nfs) handles it.
  		 */
  		if (vfslist == NULL && strpbrk(argv[0], ":@") != NULL)
! 			vfstype = "nfs";
