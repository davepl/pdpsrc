+ /* The /dev/nfsN device mounted on dir, or NULL if it is not NFS. */
+ char *
+ nfsdevice(dir)
+ 	char *dir;
+ {
+ 	static char dev[32];
+ 	struct stat sb;
+ 
+ 	if (stat(dir, &sb) < 0 || major(sb.st_dev) != NFSD_BMAJOR)
+ 		return (NULL);
+ 	(void)sprintf(dev, "/dev/nfs%d", minor(sb.st_dev));
+ 	return (dev);
+ }
