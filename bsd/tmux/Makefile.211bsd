# Generated by tools/generate_native_makefiles.py. Run from upstream.
# Clean shared objects before changing profile.
PROFILE=milestone
PROG=tmux
LINK_SCRIPT=../native/link-milestone.sh
CC=../tools/cc211
CFLAGS=-O -DTMUX_NATIVE_211BSD -DPDP11_NATIVE -I../native -I. -t01p -B../native/compiler/ -DTMUX_MILESTONE
GROUPS=G01 G02 G03 G04 G05 G06 G07 G08 G09 G10 G11 G12 G13

all: ${PROG}

../tools/cc211:
	cd ../tools && make cc211

../tools/ld211: ../tools/cc211
	cd ../tools && make ld211

objects: ../tools/cc211
	@/bin/sh -c 'status=0; for group in ${GROUPS}; do make -f ../native-mk/$$group.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes || status=1; done; exit $$status'

sizes:
	@/bin/sh -c 'status=0; for group in ${GROUPS}; do make -f ../native-mk/$$group.mk sizes || status=1; done; exit $$status'

G01: ../tools/cc211
	make -f ../native-mk/G01.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G02: ../tools/cc211
	make -f ../native-mk/G02.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G03: ../tools/cc211
	make -f ../native-mk/G03.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G04: ../tools/cc211
	make -f ../native-mk/G04.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G05: ../tools/cc211
	make -f ../native-mk/G05.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G06: ../tools/cc211
	make -f ../native-mk/G06.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G07: ../tools/cc211
	make -f ../native-mk/G07.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G08: ../tools/cc211
	make -f ../native-mk/G08.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G09: ../tools/cc211
	make -f ../native-mk/G09.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G10: ../tools/cc211
	make -f ../native-mk/G10.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G11: ../tools/cc211
	make -f ../native-mk/G11.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G12: ../tools/cc211
	make -f ../native-mk/G12.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

G13: ../tools/cc211
	make -f ../native-mk/G13.mk CC="${CC}" CFLAGS="${CFLAGS}" all sizes

${PROG}: FORCE ../tools/ld211
	make -f ../Makefile.211bsd objects
	/bin/sh ${LINK_SCRIPT}
	cp ../native/tmux.msg tmux.msg
	size ${PROG}

clean-objects:
	rm -f attributes.o buffer.o buffer-poll.o cfg.o client.o client-tty.o clock.o cmd.o
	rm -f cmd-attach-session.o cmd-bind-key.o cmd-break-pane.o cmd-choose-client.o cmd-choose-session.o cmd-choose-window.o cmd-clear-history.o cmd-clock-mode.o
	rm -f cmd-command-prompt.o cmd-confirm-before.o cmd-copy-buffer.o cmd-copy-mode.o cmd-delete-buffer.o cmd-detach-client.o cmd-display-message.o cmd-display-panes.o
	rm -f cmd-down-pane.o cmd-find-window.o cmd-generic.o cmd-has-session.o cmd-if-shell.o cmd-kill-pane.o cmd-kill-server.o cmd-kill-session.o
	rm -f cmd-kill-window.o cmd-last-window.o cmd-link-window.o cmd-list.o cmd-list-buffers.o cmd-list-clients.o cmd-list-commands.o cmd-list-keys.o
	rm -f cmd-list-panes.o cmd-list-sessions.o cmd-list-windows.o cmd-load-buffer.o cmd-lock-client.o cmd-lock-server.o cmd-lock-session.o cmd-move-window.o
	rm -f cmd-new-session.o cmd-new-window.o cmd-next-layout.o cmd-next-window.o cmd-paste-buffer.o cmd-pipe-pane.o cmd-previous-layout.o cmd-previous-window.o
	rm -f cmd-refresh-client.o cmd-rename-session.o cmd-rename-window.o cmd-resize-pane.o cmd-respawn-window.o cmd-rotate-window.o cmd-run-shell.o cmd-save-buffer.o
	rm -f cmd-select-layout.o cmd-select-pane.o cmd-select-prompt.o cmd-select-window.o cmd-send-keys.o cmd-send-prefix.o cmd-server-info.o cmd-set-buffer.o
	rm -f cmd-set-environment.o cmd-set-option.o cmd-set-window-option.o cmd-show-buffer.o cmd-show-environment.o cmd-show-options.o cmd-show-window-options.o cmd-source-file.o
	rm -f cmd-split-window.o cmd-start-server.o cmd-string.o cmd-suspend-client.o cmd-swap-pane.o cmd-swap-window.o cmd-switch-client.o cmd-unbind-key.o
	rm -f cmd-unlink-window.o cmd-up-pane.o colour.o environ.o grid.o grid-view.o grid-history.o input.o
	rm -f input-keys.o job.o key-bindings.o key-string.o layout.o layout-set.o log.o mode-key.o
	rm -f names.o options.o options-cmd.o paste.o resize.o screen.o screen-redraw.o screen-write.o
	rm -f server.o server-client.o server-fn.o server-job.o server-window.o session.o status.o tmux.o
	rm -f tty.o tty-keys.o tty-term.o utf8.o window.o window-choose.o window-clock.o window-copy.o
	rm -f window-more.o xmalloc.o xterm-keys.o osdep-unknown.o compat/asprintf.o compat/bsd-poll.o compat/getopt.o compat/strcasestr.o
	rm -f compat/strlcat.o compat/strlcpy.o compat/strtonum.o compat/vis.o compat/unvis.o compat/imsg.o compat/imsg-buffer.o ../native/strings.o
	rm -f ../native/getcwd.o ../native/termios.o ../native/forkpty.o ../native/terminfo.o ../native/protocol-check.o ../native/libc.o ../native/line-reader.o ../native/xstr.o

clean: clean-objects
	rm -f ${PROG}

FORCE:
